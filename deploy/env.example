# nginx manager 설정. 바꾼 뒤 `nm restart`(manager만) 또는 포트를 바꿨으면 `nm restart nginx`.

# 버전. `nm upgrade`가 바꾼다. manager와 nginx 이미지는 따로 올릴 수 있다
MANAGER_VERSION=__MANAGER_VERSION__
NGINX_IMAGE=__NGINX_IMAGE__

# 관리 화면을 열 도메인. 적으면 이 도메인으로 Let's Encrypt 인증서를 받아 HTTPS로만 연다
# 도메인의 DNS가 이 서버를 가리키고, 인터넷에서 80 포트로 들어올 수 있어야 한다
NGINX_MANAGER_ADMIN_DOMAIN=
# Let's Encrypt 연락 이메일(만료 안내를 받는다)
NGINX_MANAGER_ADMIN_EMAIL=
# 관리 도메인에 들어올 수 있는 주소(CIDR, 쉼표로 여럿). 비우면 모두
NGINX_MANAGER_ADMIN_ALLOW=

# 관리 화면을 이 서버에 여는 포트와 주소. 컨테이너 안은 9000 그대로다
# 주소 기본은 이 서버에서만(SSH 터널로 접속). 사내망에서 바로 쓰려면 0.0.0.0이나 서버의 사내 IP
NGINX_MANAGER_PORT=9000
NGINX_MANAGER_BIND_ADDRESS=127.0.0.1

# nginx가 이 서버에 여는 포트. 컨테이너 안은 80/443 그대로다
# 80이 아니면 Let's Encrypt 발급(HTTP-01)은 앞단이 80의 /.well-known/acme-challenge/를 넘겨 줄 때만 된다
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# 특정 IP에만 열 때(예: 203.0.113.10). 비우면 모든 주소
NGINX_BIND_ADDRESS=0.0.0.0

# `nm backup`이 남길 백업 수
NGINX_MANAGER_BACKUP_KEEP=14

TZ=Asia/Seoul

# 설정 파일 가져오기에서 /etc/nginx 말고 찾을 디렉터리. compose.override.yml에 같은 경로로 읽기 전용 마운트한다
NGINX_MANAGER_IMPORT_ROOTS=

# 메일 알림
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

#!/command/with-contenv sh
# 컨테이너가 시작될 때 nginx를 띄우기 전에 볼륨의 설정을 이 이미지의 nginx로 검증한다(FR-024).
# 결과는 관리도구가 읽어 대시보드에 보여 준다. 검증이 실패해도 관리도구는 떠야 하므로 이 스크립트는 늘 성공한다.
dir=/run/nginx-manager/startup-check
mkdir -p "$dir" /run/nginx /var/log/nginx/sites
chown nginxm:nginxm /run/nginx-manager "$dir" /run/nginx /var/log/nginx/sites

if s6-setuidgid nginxm /usr/sbin/nginx -t > "$dir/output" 2>&1; then
    echo ok > "$dir/result"
else
    echo failed > "$dir/result"
    echo "init-config-check: nginx -t failed, nginx stays down until the configuration is fixed" >&2
    cat "$dir/output" >&2
fi
date -u +%Y-%m-%dT%H:%M:%SZ > "$dir/checked-at"
chown nginxm:nginxm "$dir"/*
exit 0

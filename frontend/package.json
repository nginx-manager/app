{
  "name": "nginx-manager-editor",
  "private": true,
  "description": "원문 편집기 번들. 빌드 결과(src/main/resources/static/js/editor.bundle.js)는 저장소에 함께 둔다.",
  "scripts": {
    "build": "esbuild editor.js --bundle --minify --format=iife --legal-comments=linked --outfile=../src/main/resources/static/js/editor.bundle.js"
  },
